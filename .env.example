BOT_TOKEN=1234567890:replace_with_token_from_botfather

# socks5://user:pass@host:port или host:port:user:pass
# TELEGRAM_PROXY=155.212.96.154:64475:user:pass

# Необязательно. ID менеджеров через запятую — им пересылаются вопросы.
ADMIN_IDS=

# ЮKassa: shopId и secretKey нужны при подключении магазина в BotFather.
# В код бота они не подставляются — только PAYMENT_PROVIDER_TOKEN из BotFather.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Токен провайдера из BotFather после подключения ЮKassa (Payments -> YooMoney).
PAYMENT_PROVIDER_TOKEN=

# Цена курса в копейках: 10000 = 100 ₽ (тест LIVE), 199000 = 1 990 ₽ (прод)
COURSE_PRICE_KOPECKS=10000

# Чек 54-ФЗ для ЮKassa. 0 = не отправлять provider_data.
# 1=ОСН, 2=УСН доход, 3=УСН доход-расход, 4=ЕНВД, 5=ЕСХН, 6=Патент.
YOOKASSA_TAX_SYSTEM_CODE=2

# vat_code: 1=без НДС, 2=0%, 3=10%, 4=20%, 5=10/110, 6=20/120.
YOOKASSA_VAT_CODE=1

# Устаревший fallback, если PAYMENT_PROVIDER_TOKEN не задан.
PAYMENT_URL=

# Ссылка на закрытый канал или первый урок.
COURSE_URL=https://t.me/+JARHvPSqchhjZjBi

# Для быстрой проверки напоминаний можно временно поставить 1,2,3.
REMINDER_DELAYS_HOURS=3,24,48

DATABASE_PATH=data/bot.sqlite3
IMAGE_DIR=images

# Необязательно: защищённый endpoint POST /payment/success (ручная выдача доступа).
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_HOST=127.0.0.1
PAYMENT_WEBHOOK_PORT=8080
