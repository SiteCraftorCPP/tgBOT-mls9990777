BOT_TOKEN=1234567890:replace_with_token_from_botfather

# socks5://user:pass@host:port или host:port:user:pass
# TELEGRAM_PROXY=155.212.96.154:64475:user:pass

# Необязательно. ID менеджеров через запятую — им пересылаются вопросы.
ADMIN_IDS=

# Пока можно оставить пустым. После подключения эквайринга укажите URL оплаты.
PAYMENT_URL=

# Ссылка на закрытый канал или первый урок.
COURSE_URL=https://t.me/example_course

# Для быстрой проверки напоминаний можно временно поставить 1,2,3.
REMINDER_DELAYS_HOURS=3,24,48

DATABASE_PATH=data/bot.sqlite3
IMAGE_DIR=images

# Необязательно: защищённый endpoint POST /payment/success.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_HOST=127.0.0.1
PAYMENT_WEBHOOK_PORT=8080
